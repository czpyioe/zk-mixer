# build stage
FROM node:24-slim AS build
WORKDIR /app

COPY package*.json ./
RUN npm install --no-audit --no-fund

COPY . .

ARG VITE_CONTRACT_ADDRESS
ARG VITE_SEPOLIA_RPC_URL
ARG VITE_ETHERSCAN_API_KEY
ARG VITE_DEPLOY_BLOCK
ARG VITE_RELAYER_ADDRESS
ARG VITE_RELAYER_URL
ENV VITE_CONTRACT_ADDRESS=$VITE_CONTRACT_ADDRESS \
    VITE_SEPOLIA_RPC_URL=$VITE_SEPOLIA_RPC_URL \
    VITE_ETHERSCAN_API_KEY=$VITE_ETHERSCAN_API_KEY \
    VITE_DEPLOY_BLOCK=$VITE_DEPLOY_BLOCK \
    VITE_RELAYER_ADDRESS=$VITE_RELAYER_ADDRESS \
    VITE_RELAYER_URL=$VITE_RELAYER_URL

RUN npm run build

# serve stage
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
